extends SceneTree
# Offline baker: the committed catalog and two source sheets are the only new inputs.
# $GODOT_BIN --headless --path godot --script res://tools/slice_bullet_sheet.gd
# Old physical cells 0..191 retain their identity and original 16px art size.
const ROOT := "res://assets/bullet/"
const CATALOG := ROOT + "catalog.json"
const ATLAS := "res://assets/bullets.png"
const LAYOUT := ROOT + "atlas-layout.json"
const RUST := "res://../crates/stg-core/src/tables/touhou_appearances.rs"
const ECL := "res://ecl/game/touhou-bullets.ecl"

func _init() -> void:
	var catalog: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(CATALOG))
	var cell := int(catalog.cell_size)
	var columns := int(catalog.columns)
	var physical: Array[Image] = []
	var appearances: Array = []
	var by_pixels: Dictionary = {}
	var legacy: Dictionary = catalog.legacy
	var legacy_image := _load_rgba(ROOT + str(legacy.source))
	if legacy_image == null:
		return
	var old_cell := int(legacy.cell_size)
	var old_columns := int(legacy.columns)
	var old_count := old_columns * int(legacy.rows)
	for i in old_count:
		var tile := Image.create(cell, cell, false, Image.FORMAT_RGBA8)
		tile.fill(Color(0, 0, 0, 0))
		tile.blit_rect(legacy_image, Rect2i((i % old_columns) * old_cell,
			(i / old_columns) * old_cell, old_cell, old_cell),
			Vector2i((cell - old_cell) / 2, (cell - old_cell) / 2))
		physical.append(tile)
		var pixels := tile.get_data().hex_encode()
		if not by_pixels.has(pixels):
			by_pixels[pixels] = i
		appearances.append({"radius_raw": int(legacy.radii_raw[i / old_columns]),
			"sprite": i, "valid": true})

	var transparent := Image.create(cell, cell, false, Image.FORMAT_RGBA8)
	transparent.fill(Color(0, 0, 0, 0))
	var transparent_sprite := physical.size()
	physical.append(transparent)
	by_pixels[transparent.get_data().hex_encode()] = transparent_sprite
	var sources: Dictionary = {}
	for game in catalog.sources:
		sources[game] = _load_rgba(ROOT + str(catalog.sources[game]))
		if sources[game] == null:
			return
	var types: Array = []
	var rust := "// Generated by godot/tools/slice_bullet_sheet.gd; edit catalog.json and source sheets.\n"
	rust += "// Appended logical appearances only: (radius Q16.16, physical sprite, valid).\n"
	rust += "pub const TOUHOU_APPEARANCES: &[(i32, u16, bool)] = &[\n"
	var ecl := "// Generated by godot/tools/slice_bullet_sheet.gd from assets/bullet/catalog.json.\n"
	ecl += "// Logical shape bases; add native color 0..15. Missing native slots are invalid.\n"
	ecl += "// TH06 FIREBALL colors 0..3 select initial animation frames; TH18 fixed-color types accept all 16.\n"
	for type_data in catalog.types:
		var entry: Dictionary = type_data
		if int(entry.shape_base) != appearances.size():
			_fail("Catalog shape bases must be contiguous: " + str(entry.key))
			return
		var radius := int(entry.radius_raw)
		var valid_colors: Array = []
		for color in entry.valid_colors:
			valid_colors.append(int(color))
		var type_row := {"key": entry.key, "game": entry.game,
			"source_type": int(entry.source_type), "shape_base": int(entry.shape_base),
			"radius_raw": radius, "valid_colors": valid_colors}
		types.append(type_row)
		rust += "    // %s = %d\n" % [entry.key, int(entry.shape_base)]
		ecl += "const %s: int = %d;\n" % [entry.key, int(entry.shape_base)]
		var color_rects: Dictionary = {}
		for color_data in entry.colors:
			color_rects[int(color_data.color)] = color_data.source_rect
		for color in columns:
			var valid := color_rects.has(color)
			var sprite := transparent_sprite
			if valid:
				var coords: Array = color_rects[color]
				var region := Rect2i(int(coords[0]), int(coords[1]), int(coords[2]), int(coords[3]))
				var source: Image = sources[entry.game]
				if region.size != Vector2i(cell, cell) or not Rect2i(Vector2i.ZERO, source.get_size()).encloses(region):
					_fail("Source rectangle outside sheet: " + str(entry.key))
					return
				var tile := source.get_region(region)
				if not tile.get_used_rect().has_area():
					_fail("Valid color has empty alpha: %s color %d" % [entry.key, color])
					return
				var pixels := tile.get_data().hex_encode()
				if by_pixels.has(pixels):
					sprite = int(by_pixels[pixels])
				else:
					sprite = physical.size()
					physical.append(tile)
					by_pixels[pixels] = sprite
			appearances.append({"radius_raw": radius, "sprite": sprite, "valid": valid})
			rust += "    (%d, %d, %s),\n" % [radius, sprite, "true" if valid else "false"]
	rust += "];\n"
	var rows := ceili(float(physical.size()) / float(columns))
	var atlas := Image.create(columns * cell, rows * cell, false, Image.FORMAT_RGBA8)
	atlas.fill(Color(0, 0, 0, 0))
	for i in physical.size():
		atlas.blit_rect(physical[i], Rect2i(0, 0, cell, cell),
			Vector2i((i % columns) * cell, (i / columns) * cell))
	var layout := {"format_version": 1, "cell_size": cell, "columns": columns,
		"rows": rows, "physical_count": physical.size(), "transparent_sprite": transparent_sprite,
		"appearances": appearances, "types": types}
	if atlas.save_png(ProjectSettings.globalize_path(ATLAS)) != OK:
		_fail("Cannot save atlas: " + ATLAS)
		return
	if not _write_text(LAYOUT, JSON.stringify(layout, "\t", true) + "\n"):
		return
	if not _write_text(RUST, rust) or not _write_text(ECL, ecl):
		return
	print("BULLET BAKE OK: %dx%d, %d physical cells, %d logical appearances, %d types" % [
		columns * cell, rows * cell, physical.size(), appearances.size(), types.size()])
	quit(0)

func _load_rgba(path: String) -> Image:
	var image := Image.load_from_file(ProjectSettings.globalize_path(path))
	if image == null:
		_fail("Cannot load source: " + path)
		return null
	image.convert(Image.FORMAT_RGBA8)
	return image

func _write_text(path: String, text: String) -> bool:
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		_fail("Cannot write: " + path)
		return false
	file.store_string(text)
	return true

func _fail(message: String) -> void:
	push_error(message)
	quit(1)
